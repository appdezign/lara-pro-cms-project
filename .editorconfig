root = true

# PHP and Blade use four spaces. PHP follows the Laravel standard (PSR-12 /
# PER-CS) and is formatted by Laravel Pint with its default "laravel" preset.
# Blade templates are formatted with PhpStorm's own formatter, which follows
# this file.
#
# There are two pint.json files: one here for the project, and one in the core
# package. Pint does not descend into symlinked directories, so a run from the
# project root never sees laracms/core - format that package from its own
# directory.

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,stub}]
indent_style = space

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[docker-compose.yml]
indent_size = 4
