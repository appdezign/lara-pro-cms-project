root = true

# PHP indentation is tabs. Laravel Pint's preset would reindent to four spaces,
# so pint.json turns off the four fixers that rewrite indentation:
# indentation_type, statement_indentation, array_indentation and
# method_chaining_indentation. Pint has no setting for the indent character, so
# switching those off is what makes it indentation-agnostic; every other fixer
# still runs (import ordering, unused imports, spacing, docblock cleanup).
#
# There are two pint.json files, with identical rules: one here for the project,
# and one in the core package. Pint does not descend into symlinked directories,
# so a run from the project root never sees laracms/core - format that package
# from its own directory.

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[docker-compose.yml]
indent_size = 4
