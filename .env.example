APP_NAME="Lara CMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BOOST_ENABLED=false

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=deferred

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Mailer used for form mail outside production
MAIL_DEV_HOST=
MAIL_DEV_PORT=587
MAIL_DEV_USERNAME=
MAIL_DEV_PASSWORD=
MAIL_DEV_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Lara CMS
LARA_NEEDS_SETUP=false
LARA_PARENT_THEME=base
LARA_CLIENT_THEME=demo
LARA_FRONT_PLATFORM=tailwind
LARA_SCHEDULER_ID=0
LARA_PASSWORDS_MIN_LENGTH=6
LARA_AUTH_CAN_REGISTER=false
LARA_AUTH_CAN_RESET_PASSWORD=false
LARA_AUTH_HAS_FRONT_AUTH=false
LARA_AUTH_HAS_FRONT_PROFILE=false
LARA_API_TOKEN=
LARA_API_OBJECT_LIMIT=20

# Google
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_GEOCODING_API_KEY=
GOOGLE_RECAPTCHA_SITE_KEY=
GOOGLE_RECAPTCHA_SECRET_KEY=
GOOGLE_TRANSLATE_API_KEY=

# Cookie consent: tracking ids, empty to leave a service out
CONSENT_GA4_ID=
CONSENT_GOOGLE_ADS_ID=
CONSENT_CLARITY_ID=
CONSENT_MATOMO_URL=
CONSENT_MATOMO_SITE_ID=
CONSENT_META_PIXEL_ID=
CONSENT_TIKTOK_PIXEL_ID=
